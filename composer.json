{
  "name": "iquesters/notifications",
  "description": "Notifications for the iquesters modules: message types declared by each module, editable templates (platform defaults and per-organisation overrides), per-organisation channel settings, queued sending with a log. Email now; WhatsApp, in-app and more later.",
  "keywords": [
    "laravel",
    "notifications",
    "email",
    "templates",
    "whatsapp",
    "iquesters"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/iquesters/notifications",
  "support": {
    "issues": "https://github.com/iquesters/notifications/issues",
    "source": "https://github.com/iquesters/notifications",
    "docs": "https://github.com/iquesters/notifications/tree/main/docs"
  },
  "authors": [
    {
      "name": "Pritam Bag",
      "email": "pritam02b@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0|^13.0",
    "iquesters/foundation": "^2.1",
    "iquesters/user-interface": "^2.2",
    "iquesters/organisation": "^2.2",
    "spatie/laravel-permission": "^8.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "laravel/sanctum": "^4.0",
    "laravel/pint": "^1.18",
    "larastan/larastan": "^3.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../foundation",
      "options": {
        "symlink": true,
        "versions": {
          "iquesters/foundation": "2.99.0"
        }
      }
    },
    {
      "type": "path",
      "url": "../user-interface",
      "options": {
        "symlink": true,
        "versions": {
          "iquesters/user-interface": "2.99.0"
        }
      }
    },
    {
      "type": "path",
      "url": "../organisation",
      "options": {
        "symlink": true,
        "versions": {
          "iquesters/organisation": "2.99.0"
        }
      }
    }
  ],
  "scripts": {
    "test": "phpunit",
    "format": "pint",
    "lint": "pint --test",
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "autoload": {
    "psr-4": {
      "Iquesters\\Notifications\\": "src/",
      "Iquesters\\Notifications\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Iquesters\\Notifications\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "laravel": {
      "providers": [
        "Iquesters\\Notifications\\NotificationsServiceProvider"
      ]
    }
  }
}
